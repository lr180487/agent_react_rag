# Copiar como .env y completar localmente. Nunca subir .env al repositorio.
APP_NAME=agente_react_rag
VERSION=1.0.1
ENV=development
HOST=127.0.0.1
PORT=8000

# LangChain + langchain-openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
OPENAI_API_KEY=

# Opcionales para otros proveedores / servicios
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Infraestructura (ajustar según entorno)
DATABASE_URL=sqlite:///./agent_react_rag.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=120
PGVECTOR_DIM=1536
TAVILY_API_KEY=
SERPAPI_API_KEY=
FRONTEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
WS_LANGCHAIN_PATH=/ws/langchain
WS_HEARTBEAT_INTERVAL=2
MAX_UPLOAD_MB=20
